{
  "name": "tga-ballot",
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "share-card": "node scripts/build-share-card.mjs",
    "award-cards": "node scripts/build-award-cards.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore \"vitest run --config vitest.rules.config.js\"",
    "test:e2e": "npx --yes firebase-tools@15 emulators:exec --only firestore,auth --project tga-ballot-e2e \"playwright test\"",
    "test:e2e:ui": "npx --yes firebase-tools@15 emulators:exec --only firestore,auth --project tga-ballot-e2e \"playwright test --ui\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
