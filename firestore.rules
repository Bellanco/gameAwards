/**
 * Reglas de Firestore - Seguro para Producción
 * Publicar con: firebase deploy --only firestore:rules
 * (o pegando este contenido en Firebase Console > Firestore Database > Rules)
 *
 * Acceso de administrador (custom claims, verificado por el servidor):
 *   Firebase Admin SDK / CLI:
 *     admin.auth().setCustomUserClaims(uid, { admin: true })
 *   El usuario debe re-loguearse (o refrescar token) para recibir el claim.
 *
 * Estas reglas están cubiertas por tests contra el emulador:
 *   npm run test:rules
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Funciones auxiliares =====
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.get('admin', false) == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Nº máximo de categorías que puede traer un voto. No es el número real de
    // categorías (las reglas no deben depender de ello), solo un tope sensato
    // para que nadie escriba un mapa gigante en su propio documento.
    function maxSelections() {
      return 60;
    }

    // ¿La votación está abierta AHORA, según config/voting?
    //
    // Esta comprobación es la que hace que el calendario exista de verdad: antes
    // solo se evaluaba en el navegador (App.jsx), así que cualquiera podía
    // registrar un voto fuera de plazo desde la consola o con el reloj del
    // sistema atrasado.
    //
    // Se compara contra `opensAtMillis` / `closesAtMillis` (epoch en ms) porque
    // las reglas no saben parsear las cadenas ISO de `opensAt` / `closesAt`. Los
    // escribe seasonService, siempre en pareja con su ISO.
    //
    // Semántica (la misma que utils/votingSchedule.js): las FECHAS mandan y el
    // interruptor `isOpen` solo puede cerrar antes de tiempo, nunca abrir fuera
    // de la ventana. Una fecha ausente simplemente no restringe.
    //
    // Si config/voting NO existe todavía se considera ABIERTA, igual que hace el
    // cliente: es el estado "el admin aún no ha configurado nada" y no debe
    // bloquear la primera edición.
    function votingConfigRef() {
      return /databases/$(database)/documents/config/voting;
    }

    function votingConfigAllows() {
      let cfg = get(votingConfigRef()).data;
      return cfg.get('isOpen', true) == true &&
             (cfg.get('opensAtMillis', null) == null ||
              request.time.toMillis() >= cfg.get('opensAtMillis', null)) &&
             (cfg.get('closesAtMillis', null) == null ||
              request.time.toMillis() < cfg.get('closesAtMillis', null));
    }

    function votingIsOpen() {
      return !exists(votingConfigRef()) || votingConfigAllows();
    }

    // Nº de veces que un votante puede REHACER su papeleta después del envío
    // inicial. El voto dejó de ser inmutable (se puede corregir mientras la
    // votación siga abierta), pero cada edición es una escritura más: sin tope,
    // una sola persona podría reescribirla indefinidamente.
    //
    // El mismo número vive en `src/utils/ballotEdits.js` para la UI. Aquí es
    // donde se impone de verdad.
    function maxBallotEdits() {
      return 5;
    }

    // Campos que compone el cliente (ballotService.buildBallot).
    function ballotFields() {
      return ['userId', 'userEmail', 'userNickname', 'userDisplayName',
              'selections', 'season', 'submittedAt', 'updatedAt',
              'editCount', 'isActive'];
    }

    // Validación de esquema de un voto entrante (vale para crear y para editar).
    //
    // Comprueba tipos, tamaños y —esto es lo importante— que el correo es el del
    // token: antes `userEmail` solo tenía que ser un string, así que se podía
    // suplantar el de otra persona y el panel de admin lo mostraba tal cual.
    function isValidBallot(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(ballotFields()) &&
             d.keys().hasAll(ballotFields()) &&
             d.userId == userId &&
             d.userEmail == request.auth.token.email &&
             d.userNickname is string && d.userNickname.size() <= 50 &&
             d.userDisplayName is string &&
             d.userDisplayName.size() > 0 && d.userDisplayName.size() <= 50 &&
             d.selections is map &&
             d.selections.size() > 0 && d.selections.size() <= maxSelections() &&
             d.season is int && d.season >= 2000 && d.season <= 2999 &&
             d.submittedAt is string && d.submittedAt.size() <= 40 &&
             d.updatedAt is string && d.updatedAt.size() <= 40 &&
             d.editCount is int && d.editCount >= 0 &&
             d.isActive == true;
    }

    // Primer envío: el contador de ediciones arranca a cero.
    function isValidNewBallot(userId) {
      return isValidBallot(userId) && request.resource.data.editCount == 0;
    }

    // Edición de un voto ya emitido.
    //
    // El contador tiene que avanzar EXACTAMENTE de uno en uno: si bastara con
    // "no pasar de 5", el cliente podría reenviar siempre editCount = 1 y editar
    // sin fin. Y lo que identifica al voto (dueño, temporada y fecha del primer
    // envío) no puede cambiar por el camino.
    function isValidBallotEdit(userId) {
      let prev = resource.data;
      let next = request.resource.data;
      return isValidBallot(userId) &&
             next.editCount == prev.get('editCount', 0) + 1 &&
             next.editCount <= maxBallotEdits() &&
             next.userId == prev.userId &&
             next.season == prev.season &&
             next.submittedAt == prev.submittedAt;
    }

    // ===== ballots (votos de usuarios) =====
    match /ballots/{userId} {
      // Lectura: SOLO el propietario o un admin. (Antes: cualquier autenticado
      // podía leer email + voto de todos -> fuga de privacidad.)
      allow read: if isOwner(userId) || isAdmin();

      // Creación: solo el propietario, con esquema válido y DENTRO DE PLAZO.
      allow create: if isOwner(userId) && isValidNewBallot(userId) && votingIsOpen();

      // Actualización: el propietario puede rehacer su voto mientras la votación
      // siga abierta y le queden ediciones (maxBallotEdits). Sigue habiendo un
      // voto por persona: se reescribe el mismo documento, nunca se crea otro.
      allow update: if isOwner(userId) && isValidBallotEdit(userId) && votingIsOpen();

      // Borrado: solo admin (necesario para el reinicio anual de la edición).
      allow delete: if isAdmin();
    }

    // ===== categories (categorías - lectura pública) =====
    match /categories/{categoryId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // ===== config (estado de la votación - lectura pública) =====
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== results (archivo de resultados por temporada - lectura pública) =====
    match /results/{season} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // ===== winners / surveyWinners (compatibilidad - lectura pública) =====
    match /winners/{categoryId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /surveyWinners/{categoryId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // ===== admin (configuración sensible) =====
    match /admin/{document=**} {
      allow read, write, delete: if isAdmin();
    }
  }
}
